# Configuration du backend Undr. Copier en `.env` et adapter.
# Le fichier `.env` n'est pas versionné : ce modèle documente la configuration
# de référence, celle avec laquelle les mesures ont été réalisées.

DEBUG=False
API_HOST=127.0.0.1
API_PORT=8000

# --- Montre connectée ---
MAC_MONTRE=7B:0B:A5:16:62:0C
VIBRATION_DURATION_SECONDS=1.0   # durée du motif, PAS une latence de transmission

# --- Audio ---
AUDIO_DEVICE=                    # périphérique loopback (vide = HP par défaut)

# --- Modèle facial (EmotiEffLib / AffectNet) ---
EMOTIEFFLIB_MODEL=enet_b0_8_va_mtl
EMOTIEFFLIB_VA_GAIN=1.8          # harmonisation d'échelle : voir GET /calibration
FACE_MIN_CONFIDENCE=35.0         # porte du label (affichage), réglée sur 7 classes
FACE_MIN_MARGIN=8.0
FACE_MIN_DETECTION_CONFIDENCE=0.6
FACE_MIN_SIZE_PX=64              # crop plus petit = classification non fiable
CAPTURE_MAX_SIZE=448             # côté le plus long de la capture, en pixels
CALIBRATION_SAMPLE_LIMIT=2000

# --- Alignement temporel des canaux ---
ANALYSIS_WINDOW_SECONDS=3.0
FACE_SAMPLE_INTERVAL=0.35
FACE_MIN_SAMPLES=3
FACE_MAX_DISPERSION=0.45
FACE_SMOOTH_WINDOW=1             # lissage inter-fenêtres (1 = désactivé)
VOICE_SMOOTH_WINDOW=1

# --- Ruptures de contexte ---
SILENCE_WINDOWS_BEFORE_RESET=1
NO_FACE_WINDOWS_BEFORE_RESET=1
WARMUP_WINDOWS_AFTER_RESET=1

# --- Fiabilité vocale ---
VOICE_CONFIDENCE_MODE=stabilite  # ou "intensite" (ancien comportement)
VOICE_SUBWINDOWS=3
VOICE_MAX_DISPERSION=0.60

# --- Confrontation cross-modale (hérité de FER, circulaire : voir README) ---
FACE_VETO_MODE=desactive         # "desactive" | "penalite" | "rejet"
FACE_VETO_PENALTY=0.5
FACE_VETO_MAX_CONFIDENCE=45.0

# --- Gradation de l'alerte (à recalibrer sur corpus) ---
SEUIL_DISSONANCE_DISTANCE=0.8
ALERT_MODERATE_DISTANCE=1.5
ALERT_MODERATE_CONFIDENCE=40
ALERT_SEVERE_DISTANCE=1.8
ALERT_SEVERE_CONFIDENCE=60
